# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# env
.env

# FCM / push
# google-services.json is committed: it's non-secret (its keys are restricted by
# package name + shipped inside every APK). The service-account KEY below is the
# real secret and must never be committed.
*-firebase-adminsdk-*.json
service-account*.json

# bundle checks
dist-check/
dist-test/

secret.txt
